# Use a new local-only secret before starting Docker Compose.
POSTGRES_PASSWORD=replace-with-a-local-password
# Optional local ML lifecycle settings.
FUEL_PREDICTOR_MLFLOW_TRACKING_DIRECTORY=.fuel_predictor/mlruns
FUEL_PREDICTOR_INITIAL_SAFETY_MARGIN_LITERS=5
# Optional local monitoring thresholds.
FUEL_PREDICTOR_MISSING_ACTUAL_AFTER_DAYS=7
FUEL_PREDICTOR_MONITORING_DRIFT_SHARE_THRESHOLD=0.5
FUEL_PREDICTOR_MONITORING_ROLLING_ERROR_WINDOW=7
FUEL_PREDICTOR_MONITORING_MIN_MATCHED_OUTCOMES=3
# Optional: enables Google Maps route distances in submitted stop order.
FUEL_PREDICTOR_GOOGLE_MAPS_API_KEY=

# --- Privileged MCP tools (Phase 5) -----------------------------------------
# Off by default. Enabling exposes validate/activate/rollback over MCP, and
# only to credentials holding the models:admin scope. The plan gates these on
# the read-only surface proving itself in production and on a security review.
FUEL_PREDICTOR_MCP_PRIVILEGED_TOOLS_ENABLED=false

# --- Alert delivery (Phase 3) -----------------------------------------------
# With neither channel set, the monitoring job says plainly that nobody is
# being told rather than appearing to notify no one successfully.
# The webhook wins when both are configured.
FUEL_PREDICTOR_ALERT_WEBHOOK_URL=
FUEL_PREDICTOR_ALERT_SMTP_HOST=
FUEL_PREDICTOR_ALERT_SMTP_PORT=587
FUEL_PREDICTOR_ALERT_SMTP_USERNAME=
FUEL_PREDICTOR_ALERT_SMTP_PASSWORD=
FUEL_PREDICTOR_ALERT_EMAIL_SENDER=
# Comma-separated.
FUEL_PREDICTOR_ALERT_EMAIL_RECIPIENTS=

# --- Production deployment, compose.prod.yaml only (ADR 0012) ---------------
# Must resolve to this VM's public IP before Caddy can obtain a certificate.
DOMAIN=
ACME_EMAIL=
# The first administrator, created on first start. Remove after that account
# exists; leaving it set re-asserts the password on every restart.
#
# If you do remove these, nothing will recreate an administrator later. That is
# fine, and it is exactly why FUEL_PREDICTOR_ALLOW_UNPROVISIONED_ACCESS must
# stay false: a restore predating your accounts would otherwise bring the
# application up wide open instead of locked.
FUEL_PREDICTOR_BOOTSTRAP_ADMIN_USERNAME=
FUEL_PREDICTOR_BOOTSTRAP_ADMIN_PASSWORD=
# Leave false. True means "an empty users table serves everyone as an
# administrator", which is the original local-MVP behaviour and is never what a
# deployment wants.
FUEL_PREDICTOR_ALLOW_UNPROVISIONED_ACCESS=false

# Restrict X-Forwarded-* trust to the gateway. Leaving this as * lets any
# client forge its own source address, which poisons the audit trail.
FUEL_PREDICTOR_FORWARDED_ALLOW_IPS=*

# --- Backup, deploy/backup.sh (ADR 0012) ------------------------------------
# age PUBLIC key. The private key stays with the operator, off this VM, so a
# compromised VM cannot decrypt its own backup history.
BACKUP_AGE_RECIPIENT=
# rclone destination, e.g. s3remote:fuel-backups
BACKUP_RCLONE_REMOTE=
