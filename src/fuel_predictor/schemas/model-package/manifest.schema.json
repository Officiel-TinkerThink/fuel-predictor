{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuel-predictor.internal/schemas/model-package/manifest.schema.json",
  "title": "Model package manifest",
  "description": "Declared metadata for one candidate model package (ADR 0009). Every field here is filled in by the external training environment's packager; production only reads and validates it, never infers a missing value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "model_format",
    "runtime_compatibility_version",
    "target",
    "feature_contract_version",
    "feature_schema",
    "training_dataset_version",
    "trained_at",
    "source_revision",
    "metrics",
    "test_set_size",
    "model_size_bytes",
    "expected_memory_bytes",
    "package_checksums"
  ],
  "properties": {
    "model_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$",
      "description": "Unique identifier for this candidate, e.g. 'fuel-model-2026.08.22.1'."
    },
    "model_format": {
      "type": "string",
      "enum": ["onnx", "skops"],
      "description": "Trusted serialization formats only (ADR 0009). Pickle and Joblib are never accepted, at the schema level, regardless of what a packager might try to send."
    },
    "runtime_compatibility_version": {
      "type": "string",
      "minLength": 1,
      "description": "The production runtime version this package declares itself compatible with, e.g. an ONNX opset or a skops/scikit-learn version."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "feature_contract_version": {
      "type": "string",
      "minLength": 1,
      "description": "Must match a feature-contract version production recognizes before a candidate can be loaded."
    },
    "feature_schema": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered feature list. Order matters: it is the order production feeds inputs to the model.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["string", "number", "boolean"] }
        }
      }
    },
    "training_dataset_version": { "type": "string", "minLength": 1 },
    "trained_at": { "type": "string", "format": "date-time" },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "description": "Source-code revision the training run used, e.g. a git commit SHA."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall"],
      "properties": {
        "overall": { "$ref": "#/$defs/performanceMetrics" },
        "by_category": {
          "type": "array",
          "items": { "$ref": "#/$defs/categoryMetrics" }
        }
      }
    },
    "test_set_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Labeled, held-out test-set row count the declared metrics were computed from."
    },
    "model_size_bytes": { "type": "integer", "minimum": 1 },
    "expected_memory_bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated resident memory while loaded and serving, used for the activation capacity check (ADR 0010)."
    },
    "package_checksums": {
      "type": "object",
      "description": "SHA-256 hex digest for every member of the package archive, keyed by member filename.",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  },
  "$defs": {
    "performanceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mae", "rmse", "smape_percent", "interval_coverage_percent"],
      "properties": {
        "mae": { "type": "number", "minimum": 0 },
        "rmse": { "type": "number", "minimum": 0 },
        "smape_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "interval_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "categoryMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "mae", "rmse", "smape_percent", "interval_coverage_percent"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "mae": { "type": "number", "minimum": 0 },
        "rmse": { "type": "number", "minimum": 0 },
        "smape_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "interval_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
